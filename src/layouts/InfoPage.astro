---
// Layout for the evergreen information pages (collections, delivery, FAQ, facts).
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { business } from '../data/business.js';

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow: string;
  heading: string;
  intro: string;
  extraSchema?: object[];
  faqs?: [string, string][]; // page-specific questions: shown on the page and sent as FAQPage schema
}
const { title, description, path, eyebrow, heading, intro, extraSchema = [], faqs = [] } = Astro.props;
const faqSchema = faqs.length ? [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
}] : [];
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vaishnavijewels.com/' },
    { '@type': 'ListItem', position: 2, name: heading, item: 'https://vaishnavijewels.com' + path },
  ],
};
---
<BaseLayout title={title} description={description} canonicalPath={path} extraSchema={[crumbs, ...extraSchema, ...faqSchema]}>
  <SiteHeader />
  <main>
    <article class="info">
      <div class="container info-head">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
        <p class="lead">{intro}</p>
      </div>
      <div class="container">
        <div class="prose">
          <slot />
          {faqs.length > 0 && (
            <section class="page-faq">
              <h2>Questions we are often asked</h2>
              <dl>{faqs.map(([q, a]) => (<><dt>{q}</dt><dd>{a}</dd></>))}</dl>
            </section>
          )}
        </div>
        <aside class="cta">
          <p class="cta-title">See it in person or on a video call</p>
          <p class="cta-text">{business.addressText} &middot; {business.hoursText}</p>
          <div class="cta-row">
            <a class="btn btn-solid" href={business.whatsapp} target="_blank" rel="noopener">WhatsApp {business.phone}</a>
            <a class="btn btn-outline" href={business.mapsUrl} target="_blank" rel="noopener">Get Directions</a>
          </div>
        </aside>
      </div>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .info-head { padding: 56px 24px 24px; max-width: 800px; }
  .info-head h1 { font-size: clamp(32px, 5vw, 50px); margin: 12px 0 16px; }
  .lead { font-size: 19px; color: var(--color-ink-soft); }
  .prose { max-width: 740px; font-size: 17px; line-height: 1.75; }
  .prose :global(h2) { font-size: 28px; margin: 40px 0 14px; }
  .prose :global(h3) { font-size: 21px; margin: 28px 0 10px; }
  .prose :global(p), .prose :global(li) { color: var(--color-ink-soft); }
  .prose :global(ul) { padding-left: 22px; margin-bottom: 20px; }
  .prose :global(a) { color: var(--color-gold-deep); text-decoration: underline; }
  .prose :global(dt) { font-weight: 600; color: var(--color-ink); margin-top: 18px; }
  .prose :global(dd) { margin: 4px 0 0; color: var(--color-ink-soft); }
  .cta { max-width: 740px; margin: 48px 0 24px; padding: 28px; background: var(--color-ivory-deep); border: 1px solid var(--color-line); }
  .cta-title { font-family: var(--font-display); font-size: 24px; margin-bottom: 6px; color: var(--color-ink); }
  .cta-text { font-size: 14px; color: var(--color-ink-soft); }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 640px) { .cta-row { flex-direction: column; } .cta-row .btn { text-align: center; } }
</style>
