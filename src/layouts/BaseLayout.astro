---
// BaseLayout.astro
// Every page (homepage, blog index, individual posts) renders through this.
// The meta/SEO block below is carried over from the existing live site's
// <head> — same tags, same structured data pattern — just made dynamic
// per-page instead of hardcoded once.
import '../styles/global.css';
import { storeSchema } from '../data/business.js';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string; // e.g. "/blog/my-post" — defaults to "/"
  ogImage?: string; // absolute or root-relative path
  isArticle?: boolean;
  pubDate?: Date;
  extraSchema?: object[];
  noindex?: boolean; // previews only
}

const {
  title,
  description,
  canonicalPath = '/',
  ogImage = '/logo_vaishnavi_jewels.png',
  isArticle = false,
  pubDate,
  extraSchema = [],
  noindex = false,
} = Astro.props;

const siteUrl = 'https://vaishnavijewels.com';
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!-- SEO Meta Tags -->
  <meta name="description" content={description} />
  <meta name="author" content="Vaishnavi Gem & Jewel Pvt Ltd" />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <meta name="geo.region" content="IN-GJ" />
  <meta name="geo.placename" content="Surat, Gujarat, India" />

  <!-- Open Graph (WhatsApp / Facebook preview) -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={isArticle ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={absoluteOgImage} />
  <meta property="og:site_name" content="Vaishnavi Jewels" />
  <meta property="og:locale" content="en_IN" />
  {isArticle && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalUrl} />

  <!-- Favicon (Google search shows this next to our name; was missing -> grey globe. Owner 13/11) -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:image:alt" content="Vaishnavi Jewels, Surat" />

  <!-- Schema.org Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(storeSchema())} />
  {extraSchema.map((sch) => <script type="application/ld+json" set:html={JSON.stringify(sch)} />)}
</head>
<body>
  <slot />
  <script is:inline>
  /* Logo on photos: dark logo on light photos, light logo on dark photos (owner 11/11 14:18). */
  (function(){
    function pick(m){
      var box=m.parentElement, ph=box && box.querySelector('img.vj-photo-img, img:not(.vj-mark img)');
      if(!ph || m.dataset.vjDone) return; var src=ph.currentSrc||ph.src; if(!src) return;
      var t=new Image(); t.crossOrigin='anonymous';
      t.onload=function(){ try{
        var c=document.createElement('canvas'), w=30, h=30; c.width=w; c.height=h; var x=c.getContext('2d');
        var lg=m.querySelector('img'), pr=ph.getBoundingClientRect(), mr=lg.getBoundingClientRect(), nw=t.naturalWidth, nh=t.naturalHeight;
        if(pr.width>0 && mr.width>0){
          var k=Math.max(pr.width/nw, pr.height/nh), ox=(nw*k-pr.width)/2, oy=(nh*k-pr.height)/2;
          x.drawImage(t,(mr.left-pr.left+ox)/k,(mr.top-pr.top+oy)/k,mr.width/k,mr.height/k,0,0,w,h);
        } else { x.drawImage(t, nw*0.7, nh*0.82, nw*0.28, nh*0.15, 0, 0, w, h); }
        var d=x.getImageData(0,0,w,h).data, L=0; for(var i=0;i<d.length;i+=4){ L+=0.2126*d[i]+0.7152*d[i+1]+0.0722*d[i+2]; }
        L=L/(d.length/4);
        if(L>125){ m.classList.add('on-light'); lg.src='/logo_mark_on_light.png'; } m.dataset.vjDone='1';
      }catch(e){} };
      t.src=src;
    }
    function run(){ var ms=document.querySelectorAll('.vj-mark'); for(var i=0;i<ms.length;i++){ (function(m){ var ph=m.parentElement&&m.parentElement.querySelector('img'); if(ph&&!ph.complete){ ph.addEventListener('load',function(){pick(m);},{once:true}); } else pick(m); })(ms[i]); } }
    if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',run); else run();
  })();
  </script>
</body>
</html>
