---
// "Fresh Designs" tab shown inside a collection page (owner 20/11 17:30). Renders nothing when the category has no designs yet.
import { business as b } from '../data/business.js';
import { plain, plainSet } from '../data/images.js';
import { itemsOf } from '../data/new-designs.js';
interface Props { cat: string; label?: string }
const { cat, label = 'designs' } = Astro.props;
const items = itemsOf(cat);
const wa = (code: string, name: string) =>
  'https://wa.me/' + b.whatsappE164.replace('+', '') + '?text=' + encodeURIComponent(`Hi Vaishnavi Jewels, I saw design ${code} (${name}) on your website. Please share details.`);
const schema = items.length ? {
  '@context': 'https://schema.org', '@type': 'ItemList', name: `Fresh ${cat} designs by Vaishnavi Jewels, Surat`,
  itemListElement: items.map((d, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'ImageObject', name: d.name, caption: `${d.name} - ${d.text} Made to order by Vaishnavi Jewels, Surat.`, contentUrl: plain(d.id, 1200), creator: { '@type': 'Organization', name: 'Vaishnavi Jewels' } } })),
} : null;
---
{items.length > 0 && (
  <>
    <nav class="fd-tabs" aria-label="On this page">
      <a href="#fresh-designs" class="on">Fresh Designs ({items.length})</a>
      <a href="#collection-guide">Collection guide</a>
    </nav>
    <section id="fresh-designs" class="fd">
      <h2>Fresh {cat} Designs</h2>
      <p>Our newest {label}, each made to order in our own manufacturing unit in Surat. Choose the gold colour, natural or lab-grown diamonds and the stone colours. Tap a design to ask about it on WhatsApp.</p>
      <div class="fd-grid">
        {items.map((d) => (
          <figure class="fd-card">
            <img src={plain(d.id, 720)} srcset={plainSet(d.id, [480, 720, 960])} sizes="(max-width: 640px) 92vw, 300px" width="720" height="900" alt={d.alt} loading="lazy" decoding="async" />
            <figcaption>
              <span class="fd-code">{d.code}</span>
              <h3>{d.name}</h3>
              <p>{d.text} Made to order in Surat.</p>
              <a class="fd-btn" href={wa(d.code, d.name)} target="_blank" rel="noopener">Enquire on WhatsApp</a>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
    <div id="collection-guide"></div>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </>
)}
<style>
  .fd-tabs { display: flex; gap: 8px; margin: 0 0 24px; border-bottom: 1px solid var(--color-line, #e6dccb); }
  .fd-tabs a { padding: 10px 16px; text-decoration: none; color: var(--color-ink-soft, #5a4a44); font-size: 14px; border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .fd-tabs a.on { color: var(--color-maroon, #5a1a2a); border-bottom-color: var(--color-gold, #b08a3c); font-weight: 600; }
  .fd { scroll-margin-top: 110px; margin-bottom: 40px; }
  #collection-guide { scroll-margin-top: 110px; }
  .fd-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 20px; margin-top: 16px; }
  .fd-card { margin: 0; background: var(--color-ivory-deep, #f6efe4); border: 1px solid var(--color-line, #e6dccb); }
  .fd-card img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .fd-card figcaption { display: flex; flex-direction: column; gap: 6px; padding: 12px 14px 16px; }
  .fd-card h3 { margin: 0; font-size: 17px; }
  .fd-card p { margin: 0; font-size: 14px; color: var(--color-ink-soft, #5a4a44); }
  .fd-code { font-size: 12px; letter-spacing: 0.12em; color: var(--color-gold-deep, #8a6a2f); }
  .fd-btn { margin-top: 4px; align-self: flex-start; padding: 8px 14px; border: 1px solid var(--color-maroon, #5a1a2a); color: var(--color-maroon, #5a1a2a); text-decoration: none; font-size: 13px; }
  .fd-btn:hover { background: var(--color-maroon, #5a1a2a); color: #fff; }
</style>
