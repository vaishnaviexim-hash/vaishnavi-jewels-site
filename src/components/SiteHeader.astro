---
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <img src="https://res.cloudinary.com/rknejib2/image/upload/e_trim/f_auto,q_auto,h_200/v1790950786/vj/brand/logo_original_dark.png" alt="Vaishnavi Jewels" width="150" height="100" />
    </a>
    <nav class="nav">
      <a href="/">Home</a>
      <a href="/#collections">Collections</a>
      <a href="/#about">About</a>
      <a href="/bridal-jewellery">Bridal</a>
      <a href="/visit-us">Visit Us</a>
      <a href="/delivery-across-india">Delivery</a>
      <a href="/blog">Journal</a>
      <a href="/faq">FAQ</a>
      <a href="/#contact">Contact</a>
    </nav>
    <a href="/#contact" class="btn btn-solid enquire-btn">Enquire Now</a>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-ivory);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    padding-bottom: 10px;
    gap: 24px;
  }
  .logo {
    display: flex;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .logo img {
    height: 72px;
    width: auto;
    object-fit: contain;
  }
  .nav {
    display: flex;
    gap: 32px;
    font-size: 14px;
  }
  .nav a { color: var(--color-ink-soft); }
  .nav a:hover { color: var(--color-gold-deep); }
  .enquire-btn { font-size: 13px; padding: 11px 22px; }

  @media (max-width: 860px) {
    .nav { display: none; }
  }
</style>
