---
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <img src="/logo_vaishnavi_jewels.png" alt="Vaishnavi Jewels" />
    </a>
    <nav class="nav">
      <a href="/">Home</a>
      <a href="/#collections">Collections</a>
      <a href="/#about">About</a>
      <a href="/blog">Journal</a>
      <a href="/#contact">Contact</a>
    </nav>
    <a href="/#contact" class="btn btn-solid enquire-btn">Enquire Now</a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-ivory);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    padding-bottom: 10px;
    gap: 24px;
  }
  .logo {
    display: flex;
    align-items: center;
  }
  .logo img {
    height: 92px;
    width: auto;
    object-fit: contain;
    filter: contrast(1.4) brightness(0.7);
  }
  .nav {
    display: flex;
    gap: 32px;
    font-size: 14px;
  }
  .nav a { color: var(--color-ink-soft); }
  .nav a:hover { color: var(--color-gold-deep); }
  .enquire-btn { font-size: 13px; padding: 11px 22px; }

  @media (max-width: 860px) {
    .nav { display: none; }
  }
</style>
