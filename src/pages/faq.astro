---
import InfoPage from '../layouts/InfoPage.astro';
import { business as b } from '../data/business.js';
import autoFaqs from '../data/faq-auto.json';

// Answer-first FAQ: the first sentence of every answer is the direct answer,
// so search engines and AI assistants can quote it as-is.
// Questions come from real customer searches (Questions tab, VJ_Marketing_Engine).
const groups = [
  {
    title: 'Certificates, hallmark and checking what you buy',
    faqs: [
      ['What documents do I get when I buy diamond jewellery from Vaishnavi Jewels?', 'You get a grading report, a BIS HUID hallmark on the gold and an itemised invoice. Every solitaire has its own grading report, and every jewellery piece has a jewellery grading report; both clearly state the quality and whether the diamonds are natural or lab-grown. Small diamonds are listed with their total weight, number of pieces and quality.'],
      ['Is your jewellery certified?', 'Yes. Our solitaires and jewellery come with grading reports from IGI, EGL or TGL that state the quality and the origin (natural or lab-grown), and all our gold jewellery is BIS HUID hallmarked.'],
      ['Do earrings, pendants and rings with small diamonds come with a certificate?', 'Yes. The jewellery grading report covers the whole piece, and it states the total diamond weight, the number of diamonds and their quality, along with whether they are natural or lab-grown.'],
      ['How can I check if a diamond is real?', 'The reliable way is the grading report and the laser inscription. Every Vaishnavi solitaire has its report number laser-inscribed on the diamond, which you can see under magnification and match to the report, then verify on the laboratory\'s website. Home tricks like the fog or water test are not conclusive. We are happy to show you the inscription in our showroom.'],
      ['How do I verify the HUID on my gold jewellery?', 'Open the BIS Care app, choose "Verify HUID" and enter the 6-character HUID code stamped on the piece. The app shows the purity, the type of article and the jeweller\'s registration, which should match your invoice. We can do this check with you at the counter.'],
      ['Which diamond certificates do you provide?', 'We provide grading reports from IGI, EGL or TGL. The laboratory name is printed on every report, so you can verify the report yourself on that laboratory\'s website using the report number.'],
      ['Do lab-grown diamonds pass a diamond tester?', 'Yes. A lab-grown diamond is a real diamond, so a standard diamond tester reads it as diamond. A tester cannot tell where a diamond was grown; the grading report and the matching laser inscription are what confirm whether it is natural or lab-grown.'],
      ['Are lab-grown diamonds real diamonds?', 'Yes. A lab-grown diamond is real diamond, made of the same carbon crystal, and is grown in a laboratory. Ours come with a grading report and a laser inscription so you can verify exactly what you are buying.'],
      ['Do you sell both natural and lab-grown diamonds?', 'Yes. We offer both, and every grading report clearly states the type of diamond.'],
    ],
  },
  {
    title: 'Custom and bridal jewellery',
    faqs: [
      ['Do you make the jewellery yourselves?', 'Yes. We make jewellery in our own manufacturing unit, so any design can be customised in gold karat, diamond quality and design.'],
      ['How long does custom bridal jewellery take?', 'Usually 2 to 4 weeks, depending on the design. Share your wedding date at your first visit and we will confirm the timeline once the design is final.'],
      ['Can a ring be resized after I buy it?', 'Yes. Resizing is charged on actuals, based on the work and any gold needed. Some designs, such as rings set with diamonds all the way around, may be limited in how much they can be resized, so we will check your piece first.'],
      ['How is the gold weight shown on the bill for Polki or Jadau jewellery?', 'Our invoice itemises the piece, showing the gold weight and the stones separately, so you can see what you are paying for. Ask us to walk you through the bill before you buy.'],
    ],
  },
  {
    title: 'Visiting, delivery and payment',
    faqs: [
      ['Where is Vaishnavi Jewels located?', 'Our showroom is at 120, Rajhans Ornate - High Street Retail Mall, Parle Point, Surat, Gujarat 395007.'],
      ['Where can I buy certified diamond jewellery in Surat?', 'At Vaishnavi Jewels, Rajhans Ornate Mall, Parle Point, Surat. We have sold certified natural and lab-grown diamond jewellery since 2005, and we show you the grading report and the inscription before you buy.'],
      ['Where can I buy Polki jewellery in Surat?', 'At Vaishnavi Jewels, Rajhans Ornate Mall, Parle Point, Surat. We make Polki chokers, long necklaces, earrings and full bridal sets in our own manufacturing unit, and you can see them in the showroom or on a video call.'],
      ['Where can I buy bridal jewellery in Surat?', 'At Vaishnavi Jewels, Rajhans Ornate Mall, Parle Point, Surat. We make Polki and Kundan bridal sets, certified diamond necklace sets, solitaires and mangalsutras in our own manufacturing unit, and we can plan the jewellery for every wedding function with you.'],
      ['How long has Vaishnavi Jewels been in business?', 'Since 1 June 2005. Vaishnavi Jewels is a brand of Vaishnavi Gem & Jewel Pvt Ltd, founded by Shilpi Agarwal.'],
      ['What are your opening hours?', b.hoursText],
      ['What kind of jewellery do you sell?', 'Natural diamond jewellery, lab-grown diamond jewellery, Polki and Jadau, including bridal sets, necklaces, rings, earrings, bangles, bracelets, pendants and mangalsutras. We have over 3,000 designs.'],
      ['Do you ship across India?', 'Yes. We offer free insured delivery to major Indian cities, with the certificate and invoice. For other locations, message us and we will confirm the options.'],
      ['Can I see the jewellery on a video call before buying?', 'Yes. We show pieces live on video calls and share photos, videos and grading report details on WhatsApp, so you can decide before you pay.'],
      ['How can I pay?', 'We accept NEFT, UPI and cash. We do not offer EMI.'],
      ['How do I contact you?', 'Call or WhatsApp +91 99980 43886, or email surat@vaishnavijewels.com.'],
    ],
  },
];

groups.push({
  title: 'Exchange, buyback and after-sales',
  faqs: [
    ['Do you offer exchange and buyback?', 'Yes. We have an exchange and buyback policy for jewellery bought from us. Buyback and exchange are done against the original bill / challan along with the piece\'s certificate, so please keep both safe. Jewellery bought under a scheme is not eligible for buyback. Cash buyback is available for up to 10 years from the bill date. Call or WhatsApp us on ' + b.phone + ' and our team will explain the details for your piece.'],
    ['Can I exchange lab-grown diamond jewellery?', 'Yes. Our exchange policy also covers lab-grown diamond jewellery bought from us. Our team will explain the details for your piece.'],
    ['Can I upgrade my diamond jewellery later?', 'Yes. Under our exchange policy you can upgrade a piece bought from us to a new piece. Ask our team for the details.'],
    ['Do you accept old gold from other jewellers?', 'Yes. We accept old gold jewellery from other jewellers in exchange for new jewellery.'],
    ['Is there a warranty on your jewellery?', 'Every piece is made in our own manufacturing unit. A manufacturing defect found when you receive the piece is fixed free of cost; later repairs are charged at actual cost.'],
    ['Do you polish, repair and resize jewellery?', 'Yes. We do rhodium polishing, re-setting, resizing and repairs for diamond and gold jewellery, charged at actual cost.'],
  ],
});

// C-20261020-REACHFIX (20/10/2026): answers to real customer questions from the Questions tab
groups.push({
  title: 'Buying with confidence',
  faqs: [
    ["What should I ask a jeweller before buying a solitaire ring?", "Ask which laboratory graded the diamond and see the report; ask to see the report number laser-inscribed on the stone; confirm whether it is natural or lab-grown as stated on the report; check the gold karat and the BIS HUID on the band; and ask about resizing, exchange and buyback. At Vaishnavi Jewels we show you the report and the inscription before you pay. Read more in our guide: /blog/questions-to-ask-before-buying-a-solitaire-ring"],
    ["How do I choose a trustworthy jeweller in Surat?", "Choose a jeweller who shows you the grading report and the matching laser inscription before you pay, whose gold carries a BIS HUID you can check in the BIS Care app, who gives an itemised invoice with gold weight and stones listed separately, and who explains exchange and buyback terms clearly. Vaishnavi Jewels has worked this way at Parle Point, Surat, since 2005."],
    ["How do I see the laser inscription on my diamond, and can I see it once it is set?", "The report number is inscribed on the girdle, the thin outer edge of the diamond, and can be read under a 10x loupe or a microscope. In an open prong setting it usually stays visible; in a bezel setting it may be covered, so check it before the stone is set. We will show you the inscription in our showroom."],
    ["How do I make sure my diamond is not swapped when I give my ring for resizing or repair?", "Note the report number and check the laser inscription before you hand over the ring, ask for a receipt that records the report number, and check the inscription again when you collect it. Our resizing and repairs are done in our own manufacturing unit, and we show you the inscription at handover and at collection."],
    ["Does a lab-grown diamond come with a certificate and an inscription saying it is lab-grown?", "Yes. A lab-grown diamond grading report states clearly that the stone is laboratory-grown, and the report number is laser-inscribed on the diamond so you can match the two and verify the report on the laboratory website. Every Vaishnavi lab-grown solitaire comes with its own report and inscription."],
    ["How can I tell if a diamond has been treated or clarity-enhanced?", "Read the grading report. Recognised laboratories note treatments such as clarity enhancement or colour treatment on the report, usually in the comments. If you are unsure, ask the jeweller to confirm in writing. Every solitaire we sell comes with a report you can verify on the laboratory website."],
    ["Is my old gold jewellery without a HUID still valid?", "Yes. Hallmarking rules apply to jewellers when they sell, so gold jewellery you already own stays yours to wear, sell or exchange even without a HUID. If you want its purity confirmed, it can be tested and hallmarked at a BIS-recognised hallmarking centre through a registered jeweller. We also accept old gold from other jewellers in exchange for new jewellery."],
    ["How do I know if a diamond in my ring is loose, and how often should I get the prongs checked?", "Hold the ring near your ear and tap it gently: a rattle, or a stone that moves when pressed lightly, means it is loose. Also look for bent or flattened prongs or prongs that catch on fabric. Get diamond jewellery checked once or twice a year, and stop wearing a piece straight away if a stone feels loose. Bring it to our showroom and we will check it."],
    ["How can I tell if Polki jewellery is real?", "Real Polki uses uncut diamonds set in gold, usually with a foil backing. Ask for the stones to be described in writing on the invoice, check that the gold weight and karat are shown separately from the stones, and look closely: Polki stones are flat uncut diamonds, while Kundan-style pieces usually use glass or other stones. Read more in our guide: /blog/how-to-tell-if-polki-jewellery-is-real"],
    ["Is Polki, Kundan or Jadau jewellery hallmarked, and how do I know the gold purity?", "At Vaishnavi Jewels, yes: every piece we sell, including Polki and Jadau, carries a BIS HUID hallmark. You can check the six-character HUID in the BIS Care app, which shows the gold purity, and our itemised invoice lists the gold weight and karat separately from the stones."],
    ["Which jewellery showroom in Surat makes diamond and Polki jewellery in its own workshop?", "Vaishnavi Jewels, at 120, Rajhans Ornate Mall, Parle Point, Surat. Since 2005 we have made our diamond, Polki and bridal jewellery in our own manufacturing unit, so any design can be made to order or adjusted in size, stones and gold karat to suit your budget. Every piece is BIS HUID hallmarked and comes with its grading report."],
    ["How do I verify an IGI diamond report online?", "Go to the IGI website, open its report verification page and enter the report number printed on your report. Check that the carat weight, colour, clarity and measurements shown online match your paper report, then match the same number to the laser inscription on the girdle of the diamond under a 10x loupe. We are happy to do this check with you in our showroom."],
    ["Is 18K or 14K diamond jewellery hallmarked, and what do 750 and 585 mean?", "Yes. The gold part of diamond jewellery is hallmarked like any gold jewellery: you will see the BIS logo, the purity grade and a six-character HUID. 750 means 18 karat (75 percent gold) and 585 means 14 karat (58.5 percent gold). You can check the HUID in the BIS Care app."],
    ["Does every piece in a set, such as the necklace, earrings and tikka, have its own HUID?", "Yes. Each hallmarked gold piece carries its own HUID, so a necklace, a pair of earrings and a maang tikka each have their own code. We can show you every code against your invoice before you take the set home."],
    ["Is it safe to buy diamond jewellery from a Surat showroom by video call if I live in Ahmedabad, Vadodara or elsewhere in India?", "Yes, when the jeweller shows you the piece live on the call, shares the grading report number and the HUID before you pay so you can verify them yourself, and sends the piece by insured delivery with the report and invoice. That is how we sell to customers across India; you are always welcome to visit the showroom instead."],
    ["What should I get in writing about exchange and buyback when I buy diamond jewellery?", "Ask for an itemised invoice that lists the gold weight and karat, the diamond details and the report numbers, and ask the jeweller to explain their exchange and buyback terms clearly before you pay. We explain our exchange and buyback policy for your specific piece; buyback and exchange are done against the original bill / challan along with the piece's certificate, so please keep both safe. Jewellery bought under a scheme is not eligible for buyback. Cash buyback is available for up to 10 years from the bill date. Call or WhatsApp +91 99980 43886 for the details."],
  ],
});

// C-20261026-QSUPERVISOR: answers to every new customer question from the weekly research (Questions tab), added each Monday
const autoList = (Array.isArray(autoFaqs) ? autoFaqs : []).filter((x) => x && x.q && x.a).map((x) => [String(x.q), String(x.a)]);
if (autoList.length) groups.push({ title: 'More questions customers ask', faqs: autoList });

const all = groups.flatMap((g) => g.faqs);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: all.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<InfoPage
  title="Jewellery FAQ: Certificates, HUID, Delivery | Vaishnavi Jewels, Surat"
  description="Answers on IGI, EGL and TGL reports, BIS HUID, exchange and buyback, after-sales, Polki and bridal jewellery in Surat, video-call shopping, insured delivery and payment."
  path="/faq"
  eyebrow="QUESTIONS"
  heading="Frequently Asked Questions"
  intro="Straight answers to what customers ask us most: certificates, checking your diamond, custom work, visiting, delivery, exchange and after-sales."
  extraSchema={[faqSchema]}
>
  {groups.map((g) => (
    <section>
      <h2>{g.title}</h2>
      <dl>{g.faqs.map(([q, a]) => (<><dt>{q}</dt><dd>{a}</dd></>))}</dl>
    </section>
  ))}
</InfoPage>
