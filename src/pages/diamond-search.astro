---
// Diamond Search (owner 27/11/2026 08:35, C-20261127-DIAMONDSEARCH): our live laboratory-grown stock from the Surat sourcing network.
// Data = /stock/*.json made by the private build step: each stone shows ONLY our VJ code, the stone details and our price.
// Supplier name / number, stock id, certificate number and supplier price are never in these files (private code map, owner only).
// Enquire opens /diamond-requirement with the VJ code filled in (website acknowledgement + code number, no WhatsApp to customers).
import InfoPage from '../layouts/InfoPage.astro';
const faqs: [string, string][] = [
  ['Are these natural or laboratory-grown diamonds?', 'All stones on this page are laboratory-grown diamonds, certified by an independent lab (mostly IGI). Natural diamonds are sourced on request - tell us your requirement.'],
  ['Is the price final?', 'Prices are per stone in US dollars, including GST. A single bill above USD 1,000 gets 4% off. Stock moves fast, so we confirm availability and the final price before booking.'],
  ['How do I book a stone?', 'Press Enquire on the stone. You get a code number at once and our team calls you. Booking is on 100% advance; delivery as per our delivery policy.'],
  ['Will I get the certificate?', 'Yes. Every stone comes with its lab certificate. We share the full certificate after booking.'],
];
---
<InfoPage
  title="Diamond Search | Certified Laboratory-Grown Diamonds | Vaishnavi Jewels, Surat"
  description="Search thousands of certified laboratory-grown diamonds by shape, carat, colour, clarity and cut. Live stock from Surat, prices per stone, sourced by Vaishnavi Jewels."
  path="/diamond-search"
  eyebrow="DIAMOND SEARCH"
  heading="Find your laboratory-grown diamond"
  intro="Certified stones from Surat, the diamond city. Choose your filters and press Enquire on the stone you like."
  faqs={faqs}
  compact={true}
>
  <div class="ds" id="ds">
    <div class="ds-note"><strong>Laboratory-grown diamonds</strong>, lab certified · Prices per stone in <strong>USD incl. GST</strong> (₹ shown approx.) · <strong>4% off</strong> on a bill above USD 1,000 · Availability confirmed before booking. <span id="ds-upd"></span></div>
    <div class="ds-f">
      <div class="ds-row"><span class="ds-l">Shape</span><div class="chips" id="f-shape"></div></div>
      <div class="ds-row"><span class="ds-l">Carat</span>
        <div class="ds-ct"><input id="f-ctmin" type="text" inputmode="decimal" maxlength="6" placeholder="min" aria-label="Carat from" /><span>to</span><input id="f-ctmax" type="text" inputmode="decimal" maxlength="6" placeholder="max" aria-label="Carat to" />
          <div class="chips" id="f-ctq"></div></div></div>
      <div class="ds-row"><span class="ds-l">Colour</span><div class="chips" data-k="col" id="f-col"></div></div>
      <div class="ds-row"><span class="ds-l">Clarity</span><div class="chips" data-k="cla" id="f-cla"></div></div>
      <details class="ds-more"><summary>More filters</summary>
        <div class="ds-row"><span class="ds-l">Cut</span><div class="chips" data-k="cut" id="f-cut"></div></div>
        <div class="ds-row"><span class="ds-l">Lab</span><div class="chips" data-k="lab" id="f-lab"></div></div>
        <div class="ds-row"><span class="ds-l">Budget</span><div class="ds-ct"><span>up to USD</span><input id="f-bud" type="text" inputmode="numeric" maxlength="7" placeholder="any" aria-label="Budget per stone in USD" /><span>per stone</span></div></div>
        <div class="ds-row"><span class="ds-l">Show</span><div class="chips"><button type="button" class="chip" id="f-ideal" aria-pressed="false">Ideal proportions</button><button type="button" class="chip" id="f-vid" aria-pressed="false">With video</button></div></div>
      </details>
      <div class="ds-bar"><span id="ds-count" aria-live="polite">Loading stock…</span>
        <label class="ds-sort">Sort <select id="f-sort"><option value="p">Price: low to high</option><option value="t">Total: low to high</option><option value="c">Carat: high to low</option><option value="m">Best make first</option></select></label>
        <button type="button" class="ds-reset" id="f-reset">Clear filters</button></div>
    </div>
    <ol class="ds-list" id="ds-list"></ol>
    <button type="button" class="btn btn-solid ds-moreb" id="ds-moreb" hidden>Show more stones</button>
    <p class="ds-empty" id="ds-empty" hidden>No stone matches these filters right now. <a href="/diamond-requirement">Tell us your requirement</a> and we will source it for you.</p>
  </div>
  <style is:global>
    .ds { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); min-width: 0; }
    .ds > *, .ds-f > *, .ds-row > *, .ds-more > * { min-width: 0; }
    .ds-note { font-size: 13.5px; background: rgba(176, 141, 87, 0.09); border-left: 3px solid var(--color-gold); padding: 10px 14px; line-height: 1.6; }
    .ds-f { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; border: 1px solid rgba(58, 15, 26, 0.14); padding: 14px; background: #fff; }
    .ds-row { display: grid; grid-template-columns: 74px minmax(0, 1fr); gap: 10px; align-items: start; }
    .ds-l { font-weight: 600; font-size: 14px; padding-top: 7px; }
    .ds .chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .ds .chip { font: inherit; font-size: 13.5px; padding: 6px 10px; border: 1px solid var(--color-gold); background: transparent; cursor: pointer; min-height: 34px; color: inherit; }
    .ds .chip[aria-pressed=true] { background: var(--color-gold); color: #fff; }
    .ds .chip small { opacity: .7; margin-left: 3px; }
    .ds-ct { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .ds-ct input { font: inherit; width: 84px; padding: 7px 9px; border: 1px solid rgba(58, 15, 26, 0.25); }
    .ds-more summary { cursor: pointer; font-weight: 600; font-size: 14px; padding: 4px 0; }
    .ds-more[open] { display: grid; gap: 10px; }
    .ds-bar { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; justify-content: space-between; border-top: 1px solid rgba(58, 15, 26, 0.1); padding-top: 10px; }
    #ds-count { font-weight: 600; }
    .ds-sort select { font: inherit; padding: 6px 8px; margin-left: 6px; }
    .ds-reset { font: inherit; font-size: 13.5px; background: none; border: 0; text-decoration: underline; cursor: pointer; color: var(--color-ink-soft); }
    .ds-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    .ds-st { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 14px; border: 1px solid rgba(58, 15, 26, 0.13); padding: 12px 14px; background: #fff; }
    .ds-h { font-weight: 600; font-size: 16px; }
    .ds-d { font-size: 13.5px; color: var(--color-ink-soft); }
    .ds-c { font-size: 12px; letter-spacing: .06em; color: var(--color-ink-soft); }
    .ds-b { display: inline-block; font-size: 11.5px; padding: 1px 7px; border: 1px solid var(--color-gold); margin-left: 6px; vertical-align: 2px; }
    .ds-p { text-align: right; }
    .ds-p .tot { font-size: 19px; font-weight: 700; color: var(--color-maroon, #6b1a2a); }
    .ds-p .inr { font-size: 14.5px; font-weight: 600; }
    .ds-p .ppc { font-size: 13px; color: var(--color-ink-soft); }
    .ds-a { grid-column: 1 / -1; display: flex; gap: 8px; flex-wrap: wrap; }
    .ds-a a { min-height: 36px; box-sizing: border-box; font-size: 14px; padding: 7px 14px; border: 1px solid var(--color-gold); text-decoration: none; color: inherit; }
    .ds-a a.go { background: var(--color-gold); color: #fff !important; text-decoration: none !important; font-weight: 600; }
    .ds-a a { text-decoration: none !important; color: inherit !important; }
    .ds-q { grid-column: 1 / -1; border-top: 1px dashed rgba(58, 15, 26, 0.2); padding-top: 10px; display: grid; gap: 8px; }
    .ds-qh { margin: 0; font-size: 14.5px; }
    .ds-qf { display: grid; gap: 8px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
    .ds-mb { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 6px; min-width: 0; }
    .ds-mb select { font: inherit; font-size: 14px; padding: 8px 4px; border: 1px solid rgba(58, 15, 26, 0.25); background: #fff; max-width: 132px; }
    .ds-qf input { font: inherit; font-size: 15px; padding: 9px 10px; border: 1px solid rgba(58, 15, 26, 0.25); background: #fff; min-width: 0; }
    .ds-qs { font: inherit; font-weight: 600; background: var(--color-gold); color: #fff; border: 0; padding: 10px 14px; cursor: pointer; }
    .ds-qe { color: #9b1c1c; margin: 0; font-size: 14px; } .ds-qn { margin: 0; font-size: 12.5px; color: var(--color-ink-soft); }
    .ds-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
    .ds-ok { margin: 0; padding: 12px 14px; border: 2px solid var(--color-gold); background: rgba(176, 141, 87, 0.08); font-size: 15px; line-height: 1.6; }
    .ds-moreb { justify-self: center; }
    .ds-empty { text-align: center; }
    @media (max-width: 520px) { .ds-f { padding: 10px; gap: 8px; } .ds-row { grid-template-columns: minmax(0, 1fr); gap: 4px; } .ds-l { padding-top: 0; font-size: 13px; } .ds .chip { font-size: 13px; padding: 5px 9px; min-height: 32px; }
      #f-shape, #f-ctq { flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding-bottom: 2px; } #f-shape .chip, #f-ctq .chip { flex: 0 0 auto; white-space: nowrap; }
      .ds-ct input { width: 70px; padding: 6px 8px; } .ds-st { grid-template-columns: minmax(0, 1fr) auto; padding: 10px 12px; } .ds-h { font-size: 15px; } .ds-p .tot { font-size: 17px; } }
  </style>
  <script is:inline>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var COLS = ['D', 'E', 'F', 'G', 'H', 'Fancy'], CLA = ['FL', 'IF', 'VVS1', 'VVS2', 'VS1', 'VS2', 'SI1', 'SI2'], CUT = [['ID', 'Ideal'], ['EX', 'Excellent'], ['VG', 'Very Good']], LABS = ['IGI', 'GIA', 'GCAL'];
      var CTQ = [['0.30', '0.69'], ['0.70', '0.99'], ['1.00', '1.49'], ['1.50', '1.99'], ['2.00', '2.99'], ['3.00', '4.99'], ['5.00', '']];
      var GR = { ID: 'Ideal', EX: 'Excellent', VG: 'Very Good', G: 'Good', '8X': '8X' };
      var S = { shape: 'Round', col: [], cla: [], cut: [], lab: [], ideal: false, vid: false }, data = [], rows = [], shown = 0, cache = {}, idx = null, PAGE = 24;
      function esc(t) { return String(t == null ? '' : t).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
      function chip(label, on, extra) { var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.setAttribute('aria-pressed', on ? 'true' : 'false'); b.innerHTML = esc(label) + (extra ? '<small>' + esc(extra) + '</small>' : ''); return b; }
      function multi(el, key, list) {
        el.innerHTML = ''; list.forEach(function (it) { var v = Array.isArray(it) ? it[0] : it, l = Array.isArray(it) ? it[1] : it, b = chip(l, S[key].indexOf(v) >= 0);
          b.addEventListener('click', function () { var i = S[key].indexOf(v); if (i >= 0) S[key].splice(i, 1); else S[key].push(v); b.setAttribute('aria-pressed', i >= 0 ? 'false' : 'true'); run(); }); el.appendChild(b); });
      }
      function num(v) { var x = parseFloat(String(v).replace(',', '.')); return isFinite(x) ? x : null; }
      function ideal(r) { return r[8] != null && r[9] != null && r[8] >= 57 && r[8] <= 58.5 && r[9] >= 61 && r[9] <= 62; }
      function make(r) { var p = 0; ['ID', 'EX'].indexOf(r[4]) < 0 && (p += 1); r[5] !== 'EX' && (p += 1); r[6] !== 'EX' && (p += 1); r[7] !== 'None' && (p += 1); if (!ideal(r)) p += 0.5; return p; }
      function tot(r) { var t = r[12] * r[1]; return t >= 50 ? Math.round(t / 5) * 5 : Math.round(t); }
      function run() {
        var a = num($('f-ctmin').value), z = num($('f-ctmax').value), bud = num($('f-bud').value), so = $('f-sort').value;
        rows = data.filter(function (r) {
          if (a != null && r[1] < a) return false; if (z != null && r[1] > z) return false;
          if (S.col.length && S.col.indexOf(r[2]) < 0) return false; if (S.cla.length && S.cla.indexOf(r[3]) < 0) return false;
          if (S.cut.length && S.cut.indexOf(r[4]) < 0) return false; if (S.lab.length && S.lab.indexOf(r[10]) < 0) return false;
          if (bud != null && tot(r) > bud) return false; if (S.ideal && !ideal(r)) return false; if (S.vid && !r[13]) return false; return true;
        });
        rows.sort(so === 'c' ? function (x, y) { return y[1] - x[1] || x[12] - y[12]; } : so === 't' ? function (x, y) { return tot(x) - tot(y); } : so === 'm' ? function (x, y) { return make(x) - make(y) || x[12] - y[12]; } : function (x, y) { return x[12] - y[12] || make(x) - make(y); });
        $('ds-list').innerHTML = ''; shown = 0; more();
        $('ds-count').textContent = rows.length.toLocaleString('en-IN') + ' ' + S.shape.toLowerCase() + ' stones';
        $('ds-empty').hidden = rows.length > 0;
      }
      function card(r) {
        var li = document.createElement('li'); li.className = 'ds-st';
        var sh = S.shape === 'Other shapes' ? (r[15] || 'Fancy shape') : S.shape;
        var spec = [GR[r[4]] ? 'Cut ' + GR[r[4]] : '', r[5] ? 'Polish ' + (GR[r[5]] || r[5]) : '', r[6] ? 'Sym ' + (GR[r[6]] || r[6]) : '', 'Fluor ' + r[7]].filter(Boolean).join(' · ');
        var prop = [r[8] != null ? 'Table ' + r[8] + '%' : '', r[9] != null ? 'Depth ' + r[9] + '%' : '', r[11] ? r[11].replace(/\s+/g, ' ') + ' mm' : ''].filter(Boolean).join(' · ');
        var q = '?code=' + encodeURIComponent(r[0]) + '&shape=' + encodeURIComponent(sh) + '&ct=' + r[1] + '&col=' + encodeURIComponent(r[2]) + '&cla=' + encodeURIComponent(r[3]);
        li.innerHTML = '<div><div class="ds-h">' + esc(sh) + ' ' + r[1].toFixed(2) + ' ct · ' + esc(r[2]) + ' · ' + esc(r[3]) + (ideal(r) ? '<span class="ds-b">Ideal proportions</span>' : '') + '</div>' +
          '<div class="ds-d">' + esc(spec) + '</div>' + (prop ? '<div class="ds-d">' + esc(prop) + '</div>' : '') +
          '<div class="ds-c">' + esc(r[0]) + (r[10] ? ' · ' + esc(r[10]) + ' certified' : '') + ' · laboratory-grown</div></div>' +
          '<div class="ds-p"><div class="tot">USD ' + tot(r).toLocaleString('en-US') + '</div>' + (idx.inr ? '<div class="inr">≈ ₹' + (Math.round(tot(r) * idx.inr / 100) * 100).toLocaleString('en-IN') + '</div>' : '') + '<div class="ppc">USD ' + r[12].toLocaleString('en-US') + ' per ct</div></div>' +
          '<div class="ds-a"><a class="go" data-enq="1" href="/diamond-requirement' + q + '">Enquire</a>' + (r[13] ? '<a href="' + esc(r[13]) + '" target="_blank" rel="noopener noreferrer nofollow">Video</a>' : '') + '</div>';
        li._r = r; li._sh = sh;
        return li;
      }
      function more() { var f = document.createDocumentFragment(), end = Math.min(rows.length, shown + PAGE); for (var i = shown; i < end; i++) f.appendChild(card(rows[i])); $('ds-list').appendChild(f); shown = end; $('ds-moreb').hidden = shown >= rows.length; }
      function load(name) {
        var s = idx.shapes.filter(function (x) { return x.name === name; })[0] || idx.shapes[0]; S.shape = s.name;
        $('f-shape').querySelectorAll('.chip').forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-v') === s.name ? 'true' : 'false'); });
        $('f-cut').parentNode.hidden = !/^(Round|Old Miner)$/.test(s.name);
        if (cache[s.file]) { data = cache[s.file]; return run(); }
        $('ds-count').textContent = 'Loading ' + s.name.toLowerCase() + ' stones…';
        fetch('/stock/' + s.file + '?v=' + (idx.v || idx.updated)).then(function (r) { return r.json(); }).then(function (j) { cache[s.file] = j; if (S.shape === s.name) { data = j; run(); } })
          .catch(function () { $('ds-count').textContent = 'Could not load stock. Please refresh the page.'; });
      }

      // Quick enquiry right on the stone (owner 27/11 09:03): name + mobile -> /hooks/vj-req -> 'thank you + code number' at once.
var CCS = [['+91', 'India +91'], ['+44', 'UK +44'], ['+971', 'UAE +971'], ['+1', 'USA/Canada +1'], ['+61', 'Australia +61'], ['+64', 'New Zealand +64'], ['+65', 'Singapore +65'], ['+60', 'Malaysia +60'], ['+968', 'Oman +968'], ['+974', 'Qatar +974'], ['+966', 'Saudi +966'], ['+965', 'Kuwait +965'], ['+973', 'Bahrain +973'], ['+230', 'Mauritius +230'], ['+41', 'Switzerland +41'], ['+47', 'Norway +47'], ['+49', 'Germany +49'], ['+33', 'France +33'], ['+31', 'Netherlands +31'], ['+81', 'Japan +81'], ['+82', 'Korea +82'], ['+977', 'Nepal +977'], ['+254', 'Kenya +254'], ['+27', 'South Africa +27']];
      var DQS = ['Round', 'Oval', 'Pear', 'Cushion', 'Emerald', 'Radiant', 'Princess', 'Asscher', 'Marquise', 'Heart', 'Baguette', 'Trilliant', 'Old Miner', 'Rose Cut'];
      var DQC = ['D', 'E', 'F', 'G', 'H', 'I', 'J', 'K', 'L', 'M', 'N', 'Fancy'], DQL = ['FL', 'IF', 'VVS1', 'VVS2', 'VS1', 'VS2', 'SI1', 'SI2', 'SI3', 'I1', 'I2'];
      $('ds-list').addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[data-enq]'); if (!a) return; e.preventDefault();
        var li = a.closest('.ds-st'), box = li.querySelector('.ds-q'); if (box) { box.querySelector('input[name=nm]').focus(); return; }
        box = document.createElement('form'); box.className = 'ds-q'; box.noValidate = true;
        box.innerHTML = '<p class="ds-qh">Enquire about stone <b>' + esc(li._r[0]) + '</b></p>' +
          '<div class="ds-qf"><input name="nm" type="text" maxlength="60" autocomplete="name" placeholder="Your name" aria-label="Your name" />' +
          '<div class="ds-mb"><select name="cc" aria-label="Country code">' + CCS.map(function (c) { return '<option value="' + c[0] + '">' + c[1] + '</option>'; }).join('') + '</select><input name="mb" type="tel" maxlength="15" inputmode="tel" autocomplete="tel-national" placeholder="Mobile number" aria-label="Mobile number" /></div>' +
          '<input name="ct" type="text" maxlength="40" autocomplete="address-level2" placeholder="City (optional)" aria-label="City" />' +
          '<input name="website" type="text" tabindex="-1" autocomplete="off" class="ds-hp" aria-hidden="true" />' +
          '<button type="submit" class="ds-qs">Send enquiry</button></div><p class="ds-qe" role="alert" hidden></p>' +
          '<p class="ds-qn">Your name and number stay with Vaishnavi Jewels only.</p>';
        li.appendChild(box); box.querySelector('input[name=nm]').focus();
        box.addEventListener('submit', function (ev) {
          ev.preventDefault(); var er = box.querySelector('.ds-qe'), bt = box.querySelector('.ds-qs'); er.hidden = true; if (bt.disabled) return;
          var nm = box.nm.value.trim(), cc = box.cc.value, mb = box.mb.value.replace(/\D/g, '').replace(/^0+/, '');
          if (cc === '+91') mb = mb.replace(/^91(?=\d{10}$)/, '');
          if (!nm) { er.textContent = 'Please add your name.'; er.hidden = false; return; }
          if (cc === '+91' ? !/^[6-9]\d{9}$/.test(mb) : !/^\d{6,13}$/.test(mb)) { er.textContent = cc === '+91' ? 'Please give your 10-digit mobile number.' : 'Please give your mobile number (without the country code).'; er.hidden = false; return; }
          var mobile = cc === '+91' ? mb : cc + mb;
          var r = li._r, sh = DQS.indexOf(li._sh) >= 0 ? li._sh : 'Other';
          var body = { type: 'Lab-grown', shape: [sh], color: DQC.indexOf(r[2]) >= 0 ? [r[2]] : ['Fancy'], clarity: DQL.indexOf(r[3]) >= 0 ? [r[3]] : [], ctMin: r[1], ctMax: r[1], qty: 1,
            remarks: 'Stone ' + r[0] + ' from Diamond Search (' + li._sh + ' ' + r[1] + ' ct, USD ' + tot(r) + ')', name: nm, mobile: mobile, city: box.ct.value.trim(), website: box.website.value };
          bt.disabled = true; bt.textContent = 'Sending…';
          fetch('/hooks/vj-req', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) })
            .then(function (x) { return x.json().then(function (j) { return { ok: x.ok, j: j }; }); })
            .then(function (x) {
              if (!x.ok || !x.j.ok) { er.textContent = (x.j && x.j.error) || 'Could not send. Please try again.'; er.hidden = false; return; }
              box.innerHTML = '<p class="ds-ok"><b>Thank you, ' + esc(nm) + '!</b> We have received your enquiry for stone <b>' + esc(r[0]) + '</b>.<br>Your code number: <b>' + esc(x.j.no || '') + '</b> &middot; Our team will call you shortly.</p>';
            })
            .catch(function () { er.textContent = 'Could not send. Please check your internet and try again.'; er.hidden = false; })
            .finally(function () { if (bt.isConnected) { bt.disabled = false; bt.textContent = 'Send enquiry'; } });
        });
      });
      multi($('f-col'), 'col', COLS); multi($('f-cla'), 'cla', CLA); multi($('f-cut'), 'cut', CUT); multi($('f-lab'), 'lab', LABS);
      CTQ.forEach(function (q) { var b = chip(q[1] ? q[0] + '-' + q[1] : q[0] + '+', false); b.addEventListener('click', function () { $('f-ctmin').value = q[0]; $('f-ctmax').value = q[1]; run(); }); $('f-ctq').appendChild(b); });
      ['f-ideal', 'f-vid'].forEach(function (id) { $(id).addEventListener('click', function () { var k = id === 'f-ideal' ? 'ideal' : 'vid'; S[k] = !S[k]; $(id).setAttribute('aria-pressed', S[k] ? 'true' : 'false'); run(); }); });
      var t; ['f-ctmin', 'f-ctmax', 'f-bud'].forEach(function (id) { $(id).addEventListener('input', function () { clearTimeout(t); t = setTimeout(run, 250); }); });
      $('f-sort').addEventListener('change', run); $('ds-moreb').addEventListener('click', more);
      $('f-reset').addEventListener('click', function () { S.col = []; S.cla = []; S.cut = []; S.lab = []; S.ideal = S.vid = false; ['f-ctmin', 'f-ctmax', 'f-bud'].forEach(function (id) { $(id).value = ''; });
        document.querySelectorAll('.ds .chip').forEach(function (b) { if (!b.hasAttribute('data-v')) b.setAttribute('aria-pressed', 'false'); }); run(); });
      fetch('/stock/index.json?t=' + Math.floor(Date.now() / 600000)).then(function (r) { return r.json(); }).then(function (j) {
        idx = j; var d = new Date(j.updated + 'T12:00:00'); $('ds-upd').textContent = 'Stock updated ' + d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) + '.' + (j.inr ? ' ₹ at ₹' + j.inr + ' per USD.' : '');
        j.shapes.forEach(function (s) { var b = chip(s.name, false, s.n.toLocaleString('en-IN')); b.setAttribute('data-v', s.name); b.addEventListener('click', function () { load(s.name); }); $('f-shape').appendChild(b); });
        load('Round');
      }).catch(function () { $('ds-count').textContent = 'Could not load stock. Please refresh the page.'; });
    })();
  </script>
</InfoPage>
