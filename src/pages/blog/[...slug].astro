---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

// getStaticPaths tells Astro to generate one page per blog post file at
// build time. This is what an automation is really "publishing" into —
// dropping a new .md file into src/content/blog/ and pushing to GitHub is
// the entire act of adding a new live page.
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// T-20261027-JOURNALLINKS (02/11/2026): every post links to its collection page(s), a visit and WhatsApp.
import { business as biz } from '../../data/business.js';
const hay = (post.data.tags.join(' ') + ' ' + post.data.title + ' ' + post.slug).toLowerCase();
const COLLECTIONS = [
  [/polki|kundan/, '/polki-jewellery', 'Polki jewellery'],
  [/bridal|bride|lehenga|wedding|sangeet|reception|groom|sherwani|saree|engagement/, '/bridal-jewellery', 'Bridal jewellery'],
  [/solitaire|inscription|loupe|certificate|igi/, '/solitaire-rings', 'Certified solitaire rings'],
  [/lab[- ]?grown|cvd|hpht/, '/lab-grown-diamond-jewellery', 'Lab-grown diamond jewellery'],
  [/mangalsutra/, '/diamond-mangalsutra', 'Diamond mangalsutra'],
  [/earring/, '/diamond-earrings', 'Diamond earrings'],
];
let related = COLLECTIONS.filter(([re]) => re.test(hay)).slice(0, 3).map(([, href, label]) => ({ href, label }));
if (related.length === 0) related = [{ href: '/natural-diamond-jewellery', label: 'Natural diamond jewellery' }];
---
<BaseLayout
  title={`${post.data.title} | Vaishnavi Jewels Journal`}
  description={post.data.description}
  canonicalPath={`/blog/${post.slug}`}
  ogImage={post.data.heroImage}
  isArticle={true}
  pubDate={post.data.pubDate}
>
  <SiteHeader />
  <main>
    <article class="post">
      <div class="container post-header">
        {post.data.tags.length > 0 && (
          <p class="eyebrow">{post.data.tags.join(' · ')}</p>
        )}
        <h1>{post.data.title}</h1>
        <p class="post-date">
          {post.data.pubDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}
        </p>
      </div>

      {post.data.heroImage && (
        <div class="post-hero-img">
          <img src={post.data.heroImage} alt={post.data.title} />
        </div>
      )}

      <div class="container">
        <div class="prose">
          <Content />
        </div>
        <nav class="post-related" aria-label="Related collections">
          <p><strong>See the pieces:</strong> {related.map((r, i) => (<>{i > 0 && ' · '}<a href={r.href}>{r.label}</a></>))}</p>
          <p><a href="/book-a-visit" class="btn btn-solid">Book a visit or video call</a> <a href={biz.whatsapp} class="btn btn-outline" target="_blank" rel="noopener">WhatsApp {biz.whatsappDisplay}</a></p>
        </nav>
        <a href="/blog" class="btn btn-outline back-link">&larr; Back to Journal</a>
      </div>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .post-header {
    padding: clamp(48px, 7vw, 88px) 0 36px;
    max-width: 760px;
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 40px;
  }
  .post-header h1 { font-size: clamp(32px, 5vw, 52px); margin: 12px 0 16px; color: var(--color-maroon); }
  .post-date { font-size: 13px; color: var(--color-ink-soft); }
  .post-hero-img { margin-bottom: 40px; }
  .post-hero-img img { width: 100%; max-height: 480px; object-fit: cover; }

  .prose {
    max-width: 720px;
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-ink);
  }
  .prose :global(h2) {
    font-size: clamp(25px, 3.2vw, 32px);
    margin: 48px 0 16px;
    padding-top: 18px;
    position: relative;
  }
  .prose :global(h2)::before { content: ''; position: absolute; top: 0; left: 0; width: 40px; height: 2px; background: var(--color-gold); }
  .prose :global(h3) {
    font-size: 22px;
    margin: 32px 0 12px;
  }
  .prose :global(p) { margin-bottom: 20px; color: var(--color-ink-soft); }
  .prose :global(a) { color: var(--color-gold-deep); text-decoration: underline; }
  .prose :global(ul), .prose :global(ol) { margin-bottom: 20px; padding-left: 22px; color: var(--color-ink-soft); }

  .post-related { margin-top: 48px; max-width: 720px; padding: 28px; background: var(--color-ivory-deep); border: 1px solid var(--color-line); }
  .post-related a:not(.btn) { color: var(--color-gold-deep); text-decoration: underline; text-underline-offset: 3px; }
  .post-related .btn { margin: 6px 8px 0 0; }
  .back-link { margin: 48px 0 72px; }
</style>
