---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

// Pulls every .md file in src/content/blog/, drops drafts, sorts newest first.
// This list updates automatically — nothing to maintain by hand when a new
// post file is added by the automation.
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = "Journal | Vaishnavi Jewels";
const description = "Guides on certified diamonds, solitaires, HUID and Polki jewellery from Vaishnavi Jewels, Surat.";
---
<BaseLayout title={title} description={description} canonicalPath="/blog">
  <SiteHeader />
  <main>
    <section class="blog-hero">
      <div class="container">
        <p class="eyebrow">THE JOURNAL</p>
        <h1>Notes on craft, stone and style</h1>
        <span class="orn-rule center" aria-hidden="true"></span>
      </div>
    </section>

    <section class="blog-list">
      <div class="container">
        {posts.length === 0 && <p class="empty">New posts are on the way.</p>}
        <div class="grid">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="card">
              {post.data.heroImage && (
                <img src={post.data.heroImage} alt={post.data.title} class="card-img" />
              )}
              <p class="card-date">
                {post.data.pubDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}
              </p>
              <h2 class="card-title">{post.data.title}</h2>
              <p class="card-desc">{post.data.description}</p>
              <span class="card-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12h15M14 6l6 6-6 6" /></svg></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .blog-hero {
    padding: clamp(56px, 8vw, 96px) 0 clamp(40px, 5vw, 56px);
    border-bottom: 1px solid var(--color-line);
    text-align: center;
    background:
      radial-gradient(80% 90% at 50% 0%, rgba(227, 194, 122, 0.2) 0%, rgba(227, 194, 122, 0) 70%),
      linear-gradient(180deg, var(--color-ivory) 0%, var(--color-ivory-deep) 100%);
  }
  .blog-hero h1 { font-size: clamp(34px, 5vw, 56px); margin-top: 10px; color: var(--color-maroon); }
  .blog-list { padding: clamp(48px, 6vw, 80px) 0 40px; }
  .empty { color: var(--color-ink-soft); }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .card {
    display: flex; flex-direction: column;
    position: relative;
    background: #FFFDF8;
    border: 1px solid var(--color-line);
    padding: 30px 28px 56px;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .card::before {
    content: ''; position: absolute; top: -1px; left: 28px; width: 44px; height: 2px; background: var(--color-gold);
    transition: width 0.3s ease;
  }
  .card:hover { transform: translateY(-3px); box-shadow: var(--shadow-card); border-color: rgba(169, 133, 46, 0.55); }
  .card:hover::before { width: 88px; }
  .card-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-bottom: 16px;
  }
  .card-date {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-deep);
    margin-bottom: 10px;
  }
  .card-title {
    font-size: 23px;
    line-height: 1.22;
    margin-bottom: 12px;
    color: var(--color-ink);
  }
  .card:hover .card-title { color: var(--color-maroon); }
  .card-desc {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--color-ink-soft);
    margin: 0;
  }
  .card-arrow { position: absolute; left: 28px; bottom: 22px; width: 22px; height: 22px; }
  .card-arrow svg { width: 100%; height: 100%; fill: none; stroke: var(--color-gold); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.3s ease; }
  .card:hover .card-arrow svg { transform: translateX(6px); }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; gap: 20px; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; gap: 16px; }
    .card { padding: 24px 22px 52px; }
    .card-title { font-size: 21px; }
  }
</style>
