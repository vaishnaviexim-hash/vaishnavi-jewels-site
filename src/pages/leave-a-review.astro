---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const GOOGLE_REVIEW_URL = 'https://g.page/r/Ce9kbGlQK0O8EBM/review';

const title = "Leave a Review | Vaishnavi Jewels";
const description = "Share your experience with Vaishnavi Jewels — get help writing it, then post it as your own review on Google.";
---
<BaseLayout title={title} description={description} canonicalPath="/leave-a-review">
  <SiteHeader />
  <main>
    <section class="review-hero">
      <div class="container">
        <p class="eyebrow">SHARE YOUR EXPERIENCE</p>
        <h1>Thank you for visiting Vaishnavi Jewels</h1>
        <p class="review-intro">
          We'd love a few words from you on Google — it genuinely helps
          other people find us. Tell us a little below, and we'll help you
          put it into words. You'll get to read and edit it before posting
          anything, and it always posts from your own Google account, not
          ours.
        </p>
      </div>
    </section>

    <section class="review-form-section">
      <div class="container form-container">
        <form id="review-form">
          <label>
            Your name <span class="optional">(optional)</span>
            <input type="text" name="name" placeholder="e.g. Priya" />
          </label>

          <label>
            What did you purchase? <span class="optional">(optional)</span>
            <input type="text" name="purchase" placeholder="e.g. a Polki bridal set" />
          </label>

          <label>
            What stood out to you? <span class="required">*</span>
            <textarea
              name="highlight"
              rows="4"
              required
              placeholder="e.g. the staff spent time explaining the diamond quality, and the design matched exactly what I wanted"
            ></textarea>
          </label>

          <label>
            Tone
            <select name="tone">
              <option value="warm and simple">Warm and simple</option>
              <option value="short and to the point">Short and to the point</option>
              <option value="detailed and enthusiastic">Detailed and enthusiastic</option>
            </select>
          </label>

          <button type="submit" class="btn btn-solid" id="draft-btn">
            Help me write it
          </button>
          <p id="form-error" class="form-error" role="alert"></p>
        </form>

        <div id="draft-result" class="draft-result hidden">
          <p class="eyebrow">YOUR DRAFT &mdash; EDIT AS YOU LIKE</p>
          <textarea id="draft-textarea" rows="6"></textarea>
          <div class="draft-actions">
            <a
              id="google-link"
              href={GOOGLE_REVIEW_URL}
              target="_blank"
              rel="noopener"
              class="btn btn-solid"
            >
              Copy &amp; Open Google Review &rarr;
            </a>
          </div>
          <p class="draft-note">
            This copies your review text and opens your Google review page
            in one step &mdash; just paste it in, edit if you'd like, and
            post it as yourself.
          </p>
          <p class="draft-note-fallback hidden" id="copy-fallback">
            Couldn't copy automatically &mdash; select the text above and
            copy it manually before pasting on Google.
          </p>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script define:vars={{ GOOGLE_REVIEW_URL }}>
  const form = document.getElementById('review-form');
  const draftBtn = document.getElementById('draft-btn');
  const formError = document.getElementById('form-error');
  const draftResult = document.getElementById('draft-result');
  const draftTextarea = document.getElementById('draft-textarea');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.textContent = '';
    draftBtn.disabled = true;
    draftBtn.textContent = 'Writing...';

    const formData = new FormData(form);
    const payload = {
      name: formData.get('name'),
      purchase: formData.get('purchase'),
      highlight: formData.get('highlight'),
      tone: formData.get('tone'),
    };

    try {
      const res = await fetch('/.netlify/functions/draft-review', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();

      if (!res.ok) {
        formError.textContent = data.error || 'Something went wrong. Please try again.';
        return;
      }

      draftTextarea.value = data.draft;
      draftResult.classList.remove('hidden');
      draftResult.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      formError.textContent = 'Could not reach the server. Please check your connection and try again.';
    } finally {
      draftBtn.disabled = false;
      draftBtn.textContent = 'Help me write it';
    }
  });

  const googleLink = document.getElementById('google-link');
  const copyFallback = document.getElementById('copy-fallback');

  googleLink.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(draftTextarea.value);
    } catch {
      copyFallback.classList.remove('hidden');
      draftTextarea.select();
    }
    // Link continues to open the Google review page as normal —
    // no preventDefault, this just runs the copy alongside it.
  });
</script>

<style>
  .review-hero {
    padding: 64px 0 40px;
    text-align: center;
  }
  .review-hero h1 {
    font-size: clamp(30px, 5vw, 44px);
    margin: 12px 0 20px;
  }
  .review-intro {
    max-width: 560px;
    margin: 0 auto;
    color: var(--color-ink-soft);
    font-size: 16px;
  }

  .review-form-section {
    padding: 24px 0 88px;
  }
  .form-container {
    max-width: 560px;
  }

  form label {
    display: block;
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 20px;
  }
  .optional, .required {
    font-weight: 400;
    color: var(--color-ink-soft);
    font-size: 13px;
  }
  .required { color: var(--color-gold-deep); }

  input, textarea, select {
    width: 100%;
    margin-top: 8px;
    padding: 12px 14px;
    font-family: var(--font-body);
    font-size: 15px;
    border: 1px solid var(--color-line);
    background: var(--color-white);
    border-radius: var(--radius);
    color: var(--color-ink);
  }
  textarea { resize: vertical; }
  input:focus, textarea:focus, select:focus {
    outline: 2px solid var(--color-gold);
    outline-offset: 1px;
  }

  .form-error {
    color: #B3261E;
    font-size: 14px;
    margin-top: 12px;
  }

  .draft-result {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--color-line);
  }
  .draft-result.hidden { display: none; }
  #draft-textarea {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.6;
  }
  .draft-actions {
    display: flex;
    gap: 12px;
    margin-top: 16px;
  }
  .draft-note {
    font-size: 13px;
    color: var(--color-ink-soft);
    margin-top: 12px;
  }

  @media (max-width: 480px) {
    .draft-actions { flex-direction: column; }
  }
</style>
