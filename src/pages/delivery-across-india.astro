---
import InfoPage from '../layouts/InfoPage.astro';
const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to buy jewellery from Vaishnavi Jewels from anywhere in India',
  step: [
    { '@type': 'HowToStep', name: 'Tell us what you are looking for', text: 'Message us on WhatsApp at +91 99980 43886 with the piece, occasion or a reference photo.' },
    { '@type': 'HowToStep', name: 'Get personal guidance', text: 'We guide you personally on WhatsApp and share certificate details.' },
    { '@type': 'HowToStep', name: 'Confirm and pay', text: 'Confirm the final piece and pay by NEFT or UPI.' },
    { '@type': 'HowToStep', name: 'Receive insured delivery', text: 'We ship with free insured delivery to major Indian cities, along with the certificate and invoice.' },
  ],
};
---
<InfoPage
  title="Jewellery Delivery Across India | Vaishnavi Jewels, Surat"
  description="Buy certified diamond jewellery, solitaire rings and Polki from Vaishnavi Jewels, Surat from anywhere in India: personal guidance, NEFT/UPI payment and free insured delivery."
  path="/delivery-across-india"
  eyebrow="SHOP FROM ANYWHERE IN INDIA"
  heading="Delivery Across India"
  intro="You do not need to be in Surat to buy from us. Here is how it works."
  extraSchema={[howTo]}
>
  <section class="vj-pin" aria-labelledby="vj-pin-h">
    <h2 id="vj-pin-h">Check delivery to your pincode</h2>
    <form class="vj-pin-form" id="vjPinForm" novalidate>
      <label for="vjPin" class="vj-pin-label">Enter your 6-digit pincode</label>
      <div class="vj-pin-row">
        <input id="vjPin" name="pin" inputmode="numeric" autocomplete="postal-code" maxlength="6" pattern="[0-9]{6}" placeholder="e.g. 560064" />
        <button type="submit">Check</button>
      </div>
    </form>
    <div class="vj-pin-out" id="vjPinOut" role="status" aria-live="polite"></div>
  </section>
  <style>
    .vj-pin{margin:0 0 2rem;padding:1.25rem;border:1px solid rgba(160,120,70,.35);border-radius:12px;background:rgba(160,120,70,.06)}
    .vj-pin h2{margin-top:0}
    .vj-pin-label{display:block;margin-bottom:.5rem;font-weight:600}
    .vj-pin-row{display:flex;gap:.5rem;flex-wrap:wrap}
    .vj-pin-row input{flex:1 1 10rem;min-width:0;font-size:1.1rem;padding:.6rem .8rem;border:1px solid rgba(0,0,0,.25);border-radius:8px;letter-spacing:.08em}
    .vj-pin-row button{font-size:1rem;padding:.6rem 1.4rem;border:0;border-radius:8px;background:#5b2c3a;color:#fff;cursor:pointer}
    .vj-pin-out{margin-top:1rem;line-height:1.55}
    .vj-pin-out .ok{color:#1d6b35;font-weight:700}
    .vj-pin-out .warn{color:#8a5a00;font-weight:700}
  </style>
  <script is:inline>
  (function(){
    var f=document.getElementById('vjPinForm'),i=document.getElementById('vjPin'),o=document.getElementById('vjPinOut'),data=null;
    function esc(s){return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
    function wa(pin){return 'https://wa.me/919998043886?text='+encodeURIComponent('Hi Vaishnavi Jewels, please confirm delivery to pincode '+pin)}
    function show(pin){
      var r=data.p[pin];
      if(!r){o.innerHTML='We could not find pincode <strong>'+esc(pin)+'</strong>. Please check it, or <a href="'+wa(pin)+'" rel="noopener">WhatsApp us</a> and we will confirm.';return}
      var place=esc(r[0]<0?r[1]:data.c[r[0]][0]);
      if(r[0]<0){o.innerHTML='<span class="warn">We will confirm delivery to '+place+' ('+esc(pin)+') personally.</span><br><a href="'+wa(pin)+'" rel="noopener"><strong>WhatsApp us your pincode</strong></a> and we will share the best delivery option for your location.';return}
      var c=data.c[r[0]];
      if(c[1]){o.innerHTML='<span class="ok">Yes, we deliver to '+place+' ('+esc(pin)+').</span><br>Fully insured courier, usually 2 to 5 days. An <strong>extra delivery charge</strong> applies for this location - <a href="'+wa(pin)+'" rel="noopener">WhatsApp us</a> and we will share the details.'}
      else{o.innerHTML='<span class="ok">Yes! Free insured delivery to '+place+' ('+esc(pin)+').</span><br>Fully insured courier, usually 2 to 5 days, with certificate and invoice. <a href="'+wa(pin)+'" rel="noopener">WhatsApp us</a> to order.'}
    }
    i.addEventListener('input',function(){i.value=i.value.replace(/\D/g,'').slice(0,6)});
    f.addEventListener('submit',function(e){
      e.preventDefault();var pin=i.value.trim();
      if(!/^[1-9][0-9]{5}$/.test(pin)){o.textContent='Please enter a valid 6-digit pincode.';return}
      if(data){show(pin);return}
      o.textContent='Checking...';
      fetch('/delivery-pins.json').then(function(r){if(!r.ok)throw 0;return r.json()}).then(function(d){data=d;show(pin)}).catch(function(){o.innerHTML='Could not check right now. Please <a href="'+wa(pin)+'" rel="noopener">WhatsApp us</a> and we will confirm.'});
    });
  })();
  </script>

  <h2>How it works</h2>
  <ul>
    <li><strong>Tell us what you want.</strong> WhatsApp us at <a href="https://wa.me/919998043886">+91 99980 43886</a> with the piece, occasion or a reference photo.</li>
    <li><strong>Personal guidance.</strong> We guide you personally on WhatsApp and share certificate details.</li>
    <li><strong>Pay securely.</strong> Payment by NEFT or UPI.</li>
    <li><strong>Insured delivery.</strong> Free insured shipping to major Indian cities, with the certificate and invoice.</li>
  </ul>
  <figure class="vj-fig"><div class="vj-fig-frame"><img class="vj-photo-img" src="https://res.cloudinary.com/rknejib2/image/upload/f_auto,q_auto,c_fill,ar_4:5,g_auto,w_720/vj/design_gemini/ww_branded_boxes_20261028153531" srcset="https://res.cloudinary.com/rknejib2/image/upload/f_auto,q_auto,c_fill,ar_4:5,g_auto,w_480/vj/design_gemini/ww_branded_boxes_20261028153531 480w, https://res.cloudinary.com/rknejib2/image/upload/f_auto,q_auto,c_fill,ar_4:5,g_auto,w_720/vj/design_gemini/ww_branded_boxes_20261028153531 720w, https://res.cloudinary.com/rknejib2/image/upload/f_auto,q_auto,c_fill,ar_4:5,g_auto,w_960/vj/design_gemini/ww_branded_boxes_20261028153531 960w" sizes="(max-width: 520px) 92vw, 460px" width="720" height="900" alt="Vaishnavi Jewels gift boxes used for insured delivery" loading="lazy" decoding="async" /><span class="vj-mark sm" aria-hidden="true"><img src="/logo_mark_on_dark.png" alt="" width="45" height="30" loading="lazy" /></span></div></figure>

  <h2>Certificates</h2>
  <p>Diamond jewellery comes with certificates from recognised laboratories such as IGI, TGL and EGL where applicable, and gold jewellery is BIS HUID hallmarked.</p>

  <h2>Custom orders</h2>
  <p>Because we manufacture in-house, custom and made-to-order pieces can also be delivered. We share progress on WhatsApp before dispatch.</p>
  <figure class="vj-fig"><div class="vj-fig-frame"><img class="vj-photo-img" src="https://res.cloudinary.com/rknejib2/image/upload/f_auto,q_auto,c_fill,ar_4:5,g_auto,w_720/vj/concept/web_sec_videocall_20261111130856" srcset="https://res.cloudinary.com/rknejib2/image/upload/f_auto,q_auto,c_fill,ar_4:5,g_auto,w_480/vj/concept/web_sec_videocall_20261111130856 480w, https://res.cloudinary.com/rknejib2/image/upload/f_auto,q_auto,c_fill,ar_4:5,g_auto,w_720/vj/concept/web_sec_videocall_20261111130856 720w, https://res.cloudinary.com/rknejib2/image/upload/f_auto,q_auto,c_fill,ar_4:5,g_auto,w_960/vj/concept/web_sec_videocall_20261111130856 960w" sizes="(max-width: 520px) 92vw, 460px" width="720" height="900" alt="Customer choosing a diamond and polki choker set with Vaishnavi Jewels" loading="lazy" decoding="async" /><span class="vj-mark sm" aria-hidden="true"><img src="/logo_mark_on_dark.png" alt="" width="45" height="30" loading="lazy" /></span></div></figure>

  <h2>Other locations</h2>
  <p>For towns outside the major cities, or for delivery outside India, message us and we will confirm the options for your location. More answers in our <a href="/faq">FAQ</a>.</p>
</InfoPage>
