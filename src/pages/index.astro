---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import { business as b } from '../data/business.js';
import { plain, plainSet, LOGO_DARK } from '../data/images.js';

// Photos: beautified images of our own pieces (Cloudinary vj/design_gemini), light transforms only.
const HERO = { id: 'vj/design_gemini/vs2_bridal_s3_20261012170959', alt: 'Bride wearing a Vaishnavi Jewels Polki and emerald bridal set with maang tikka and jhumkas' };
const SHOWROOM = { id: 'vj/design_gemini/showroom_people_20261021_20261021115745', alt: 'Inside the Vaishnavi Jewels showroom at Rajhans Ornate Mall, Parle Point, Surat' };
// Same collection links as before (same order and words); the first five now show a photo.
const cards = [
  { href: '/natural-diamond-jewellery', label: 'Natural diamond jewellery', id: 'vj/design_gemini/ww_diamond_line_necklace_20261028152845', alt: 'Natural diamond necklace by Vaishnavi Jewels on a velvet bust' },
  { href: '/lab-grown-diamond-jewellery', label: 'Lab-grown diamond jewellery', id: 'vj/design_gemini/web_lgd_tennis_cream_20261111070317', alt: 'Lab-grown diamond bracelet in rose gold by Vaishnavi Jewels, worn on the wrist' },
  { href: '/solitaire-rings', label: 'Solitaire rings', id: 'vj/design_gemini/gbp_round_solitaire_20261022153639', alt: 'Round solitaire ring in rose gold with pave shoulders by Vaishnavi Jewels' },
  { href: '/bridal-jewellery', label: 'Bridal jewellery', id: 'vj/design_gemini/ww_polki_bridal_set_20261028152801', alt: 'Bridal necklace and earrings set by Vaishnavi Jewels on a velvet stand' },
  { href: '/polki-jewellery', label: 'Polki jewellery', id: 'vj/design_gemini/vs2_bridal_s2_20261012170916', alt: 'Bride wearing a Vaishnavi Jewels three-tier Polki necklace set with emeralds' },
];


const title = "Diamond Jewellery in Surat | Jewellers near Parle Point | Vaishnavi Jewels";
const description = "Certified diamond jewellery made in Surat since 2005: natural and lab-grown diamonds, solitaires, Polki and bridal sets. Rajhans Ornate Mall, Parle Point.";
---
<BaseLayout title={title} description={description} canonicalPath="/">
  <SiteHeader />

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-inner">
          <h1 class="eyebrow hero-eyebrow">Certified Diamond Jewellery in Surat &middot; Jewellers near Parle Point &middot; Est. 2005</h1>
          <p class="hero-headline">
            <em>Your Vision.</em><br/>
            Our Craft.
          </p>
          <span class="orn-rule hero-rule" aria-hidden="true"></span>
          <p class="hero-sub">A Designer Jewellery House &middot; Certified Natural &amp; Lab-Grown Diamonds</p>
          <p class="hero-tag">Solitaire Rings &middot; Bridal &middot; Polki</p>
          <p class="hero-detail">Over 3,000 Designs<br/>Made in Surat, the Diamond City<br/>Diamond jewellery from {b.priceFrom}</p>

          <div class="hero-actions">
            <a href="#collections" class="btn btn-solid">Explore Collections</a>
            <a href={b.whatsapp} target="_blank" rel="noopener" class="btn btn-maroon">WhatsApp Us</a>
            <a href="/book-a-visit" class="btn btn-outline">Book a Showroom Visit</a>
          </div>
          <div class="hero-social">
            <a href="https://instagram.com/vaishnavijewels.surat" target="_blank" rel="noopener" class="btn btn-outline btn-sm">Follow Us on Instagram</a>
            <a href="https://g.page/r/Ce9kbGlQK0O8EBM/review" target="_blank" rel="noopener" class="btn btn-outline btn-sm">Rate Us on Google</a>
          </div>
        </div>
        <figure class="hero-pic">
          <div class="vj-photo hero-frame">
            <img class="vj-photo-img" src={plain(HERO.id, 900)} srcset={plainSet(HERO.id, [480, 720, 900, 1200])}
                 sizes="(max-width: 900px) 88vw, 460px" width="768" height="960" alt={HERO.alt}
                 fetchpriority="high" decoding="async" />
            <span class="vj-mark" aria-hidden="true"><img src={LOGO_DARK} alt="" width="60" height="40" /></span>
          </div>
        </figure>
      </div>
    </section>

    <section class="trust" aria-label="Why buyers trust us">
      <div class="trust-band">
        <ul class="container trust-list">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M8 12h8M12 8v8" /></svg><div><strong>Laser-inscribed solitaires</strong><span>Every solitaire carries its report number, verifiable online</span></div></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12l4 6-10 12L2 9l4-6zm-1.5 6h15M9 3l3 6 3-6M12 9v12" /></svg><div><strong>Certified diamonds</strong><span>IGI, EGL and TGL reports</span></div></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5l8-3zm-3.5 10l2.5 2.5 4.5-5" /></svg><div><strong>BIS HUID hallmarked</strong><span>Check any piece in the BIS Care app</span></div></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18M5 21V10l7-5 7 5v11M9 21v-6h6v6" /></svg><div><strong>Our own manufacturing unit</strong><span>Any design made to your choice</span></div></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg><div><strong>Since 2005</strong><span>Rajhans Ornate Mall, Parle Point, Surat</span></div></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h12v10H3zM15 10l6-3v10l-6-3" /></svg><div><strong>Shop from anywhere</strong><span>Free insured delivery across India</span></div></li>
        </ul>
      </div>
      <div class="container">
        <p class="trust-link"><a href="/solitaire-rings">How to verify a solitaire</a> &middot; <a href="/faq">Certificates and HUID questions</a> &middot; <a href="/delivery-across-india">Delivery across India</a></p>
        <nav class="shop" aria-label="Shop by collection">
          <div class="cards">
            {cards.map((c, i) => (
              <a href={c.href} class="card">
                <span class="vj-photo card-frame">
                  <img class="vj-photo-img" src={plain(c.id, 480)} srcset={plainSet(c.id, [320, 480, 720])}
                       sizes="(max-width: 640px) 46vw, (max-width: 1000px) 30vw, 210px"
                       width="480" height="600" alt={c.alt} loading="lazy" decoding="async" />
                  <span class="vj-mark sm" aria-hidden="true"><img src={LOGO_DARK} alt="" width="45" height="30" loading="lazy" /></span>
                </span>
                <span class="card-label">{c.label}</span>
              </a>
            ))}
          </div>
          <p class="trust-link more-links">
            <a href="/jadau-jewellery">Jadau jewellery</a> &middot;
            <a href="/visit-us">Visit our showroom</a> &middot;
            <a href="/blog">Journal</a>
          </p>
        </nav>
      </div>
    </section>

    <InstagramFeed
      sectionId="collections"
      eyebrow="OUR DESIGNS"
      heading="Recent Collections"
      limit={6}
    />

    <section id="about" class="about">
      <div class="container about-grid">
        <div class="about-head">
          <p class="eyebrow">ABOUT US</p>
          <h2>Two decades of honest hands, flawless jewels.</h2>
          <span class="orn-rule" aria-hidden="true"></span>
        </div>
        <div class="about-copy">
          <p class="about-body">
            Founded in 2005 by Shilpi Agarwal, who leads its design vision,
            Vaishnavi Jewels is a designer jewellery house in Surat: our designs
            are created and made in our own manufacturing unit, and you can see
            them at our self-owned 2,500 sq ft showroom at Rajhans Ornate Mall,
            Parle Point. We hold over 3,000 designs in certified natural and
            lab-grown diamond jewellery and Polki &mdash; from <a href="/solitaire-rings">solitaire rings</a>
            and mangalsutras to <a href="/bridal-jewellery">bridal necklace sets</a>,
            earrings and daily wear.
          </p>
          <p class="about-body">
            What sets us apart is design made for you: bring your own idea or
            take any of our designs, and we bring it to life &mdash; changing the
            gold karat, the diamond quality, the diamond origin, and the design
            itself. Every piece is certified, BIS HUID hallmarked and made in
            our own manufacturing unit, by a team that has worked with us for
            two decades.
          </p>
        </div>
      </div>
    </section>

    <section id="contact" class="contact">
      <div class="container contact-grid-wrap">
        <div class="contact-inner">
          <p class="eyebrow">VISIT US</p>
          <h2>Jewellers near Parle Point, Surat</h2>
          <p class="about-body">Find us at Rajhans Ornate Mall, Parle Point. Walk in during opening hours, or <a href="/visit-us">plan your visit</a>.</p>
          <div class="contact-grid">
            <div class="contact-block">
              <p class="contact-label">Address</p>
              <p class="contact-value">{b.addressText}<br/>{b.hoursText}</p>
            </div>
            <div class="contact-block">
              <p class="contact-label">Phone / WhatsApp</p>
              <p class="contact-value">
                <a href={'tel:' + b.phoneE164}>{b.phone}</a>
              </p>
            </div>
            <div class="contact-block">
              <p class="contact-label">Email</p>
              <p class="contact-value">
                <a href={'mailto:' + b.email}>{b.email}</a>
              </p>
            </div>
          </div>
          <div class="contact-cta-row">
            <a href={b.whatsapp} target="_blank" rel="noopener" class="btn btn-solid whatsapp-btn">
              Chat on WhatsApp
            </a>
            <!-- Uses a text-address search, which is reliable and needs no
            extra setup. If you ever want to point at the exact pin instead of
            an address match, swap the destination param for your Google Maps
            Place ID (found via Google's Place ID Finder tool). -->
            <a
              href="https://www.google.com/maps/dir/?api=1&destination=Rajhans+Ornate+Mall%2C+Parle+Point%2C+Surat%2C+Gujarat"
              target="_blank"
              rel="noopener"
              class="btn btn-outline directions-btn"
            >
              Get Directions
            </a>
          </div>
        </div>
        <figure class="contact-pic">
          <div class="vj-photo contact-frame">
            <img class="vj-photo-img" src={plain(SHOWROOM.id, 720)} srcset={plainSet(SHOWROOM.id, [480, 720, 928])}
                 sizes="(max-width: 900px) 92vw, 420px" width="720" height="894" alt={SHOWROOM.alt}
                 loading="lazy" decoding="async" />
            <span class="vj-mark" aria-hidden="true"><img src={LOGO_DARK} alt="" width="60" height="40" loading="lazy" /></span>
          </div>
        </figure>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    background:
      radial-gradient(90% 70% at 88% 18%, rgba(227, 194, 122, 0.22) 0%, rgba(227, 194, 122, 0) 60%),
      linear-gradient(180deg, var(--color-ivory) 0%, var(--color-ivory-deep) 100%);
    padding: clamp(48px, 7vw, 96px) 0 clamp(56px, 7vw, 96px);
    border-bottom: 1px solid var(--color-line);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .hero-inner { max-width: 640px; }
  .hero-eyebrow {
    margin: 0 0 1em;
    line-height: 1.7;
    text-transform: uppercase;
    font-size: 12.5px;
    letter-spacing: 0.16em;
  }
  .hero-headline {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.04;
    color: var(--color-maroon);
    font-size: clamp(52px, 7.4vw, 96px);
    margin: 14px 0 6px;
    letter-spacing: -0.01em;
  }
  .hero-headline em { font-style: italic; font-weight: 400; color: var(--color-gold-deep); }
  .hero-rule { margin: 26px 0; }
  .hero-sub {
    font-size: 17px;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    margin-bottom: 6px;
  }
  .hero-tag {
    font-family: var(--font-display);
    font-size: 24px;
    font-style: italic;
    color: var(--color-gold-deep);
    margin-bottom: 14px;
  }
  .hero-detail {
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-ink-soft);
    margin-bottom: 32px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-actions .btn { min-width: 172px; }
  .hero-social { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
  .btn-sm { padding: 10px 18px; font-size: 13px; border-color: var(--color-line); color: var(--color-ink-soft); background: rgba(255, 255, 255, 0.4); }
  .btn-sm:hover { border-color: var(--color-ink); }

  .hero-pic { margin: 0; position: relative; justify-self: end; width: 100%; max-width: 460px; }
  .hero-pic::before {
    content: ''; position: absolute; inset: 12px; border: 1px solid rgba(240, 220, 170, 0.8); z-index: 2; pointer-events: none;
  }
  .hero-frame { position: relative; z-index: 1; aspect-ratio: 4 / 5; box-shadow: 0 30px 70px rgba(58, 15, 26, 0.28); }
  .hero-frame img { object-position: center 22%; }

  /* Trust band */
  .trust { padding: 0 0 8px; }
  .trust-band { background: linear-gradient(120deg, var(--color-maroon-deep) 0%, var(--color-maroon) 60%, #4A1522 100%); color: #F3E7CF; }
  .trust-list {
    list-style: none; margin: 0 auto;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0;
    padding-top: 12px; padding-bottom: 12px;
  }
  .trust-list li { display: flex; gap: 14px; align-items: flex-start; padding: 20px 18px; border-left: 1px solid rgba(227, 194, 122, 0.18); }
  .trust-list li:nth-child(3n+1) { border-left: 0; }
  .trust-list svg { width: 30px; height: 30px; flex: none; fill: none; stroke: var(--color-gold-light); stroke-width: 1.3; stroke-linejoin: round; stroke-linecap: round; margin-top: 2px; }
  .trust-list strong { display: block; font-family: var(--font-display); font-weight: 500; font-size: 19px; color: #FFF8EA; margin-bottom: 2px; letter-spacing: 0.01em; }
  .trust-list span { font-size: 13px; color: rgba(243, 231, 207, 0.78); line-height: 1.5; }
  .trust-link { text-align: center; font-size: 14px; margin-top: 28px; color: var(--color-ink-soft); }
  .trust-link a { color: var(--color-gold-deep); text-decoration: underline; text-underline-offset: 3px; }

  /* Collection cards */
  .shop { margin-top: clamp(40px, 6vw, 72px); }
  .cards { display: grid; grid-template-columns: repeat(5, 1fr); gap: 18px; }
  .card { display: block; text-align: center; }
  .card-frame { display: block; aspect-ratio: 4 / 5; box-shadow: var(--shadow-card); }
  .card-frame img.vj-photo-img { transition: transform 0.7s ease; object-position: center 35%; }
  .card:hover .card-frame img.vj-photo-img { transform: scale(1.05); }
  .card-label {
    display: block; margin-top: 14px;
    font-family: var(--font-display); font-size: 19px; color: var(--color-ink);
    transition: color 0.2s ease;
  }
  .card:hover .card-label { color: var(--color-gold-deep); }
  .more-links { margin-top: 26px; }

  .about-body a { color: var(--color-gold-deep); text-decoration: underline; text-underline-offset: 3px; }

  /* About */
  .about, .contact {
    padding: var(--section-pad) 0;
    border-top: 1px solid var(--color-line);
  }
  .about { background: linear-gradient(180deg, var(--color-ivory-deep) 0%, var(--color-ivory) 100%); }
  .about-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 6vw, 88px); align-items: start; }
  .about h2, .contact h2 {
    font-size: clamp(30px, 4vw, 44px);
    margin: 12px 0 8px;
    color: var(--color-maroon);
  }
  .about-copy { border-left: 1px solid var(--color-line); padding-left: clamp(0px, 3vw, 40px); }
  .about-body { color: var(--color-ink-soft); font-size: 17.5px; line-height: 1.85; }

  /* Contact / visit */
  .contact-grid-wrap { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .contact-inner { max-width: 640px; }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 32px 0;
    padding: 24px 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .contact-block:first-child { grid-column: 1 / -1; }
  .contact-label {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-deep);
    margin-bottom: 6px;
  }
  .contact-value {
    font-size: 15.5px;
    color: var(--color-ink-soft);
    margin: 0;
  }
  .contact-value a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; }
  .contact-cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .contact-pic { margin: 0; position: relative; width: 100%; max-width: 420px; justify-self: end; }
  .contact-pic::before { content: ''; position: absolute; inset: 12px; border: 1px solid rgba(240, 220, 170, 0.8); z-index: 2; pointer-events: none; }
  .contact-frame { position: relative; z-index: 1; aspect-ratio: 4 / 5; box-shadow: var(--shadow-soft); }

  @media (max-width: 1000px) {
    .cards { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-inner { max-width: none; text-align: center; margin: 0 auto; }
    .hero-rule { margin-left: auto; margin-right: auto; }
    .hero-actions, .hero-social { justify-content: center; }
    .hero-pic { justify-self: center; max-width: 400px; width: calc(100% - 22px); }
    .trust-list { grid-template-columns: 1fr 1fr; }
    .trust-list li { border-left: 0; border-top: 1px solid rgba(227, 194, 122, 0.18); }
    .trust-list li:nth-child(-n+2) { border-top: 0; }
    .about-grid, .contact-grid-wrap { grid-template-columns: 1fr; }
    .about-copy { border-left: 0; padding-left: 0; }
    .contact-pic { justify-self: center; max-width: 380px; width: calc(100% - 18px); }
  }
  @media (max-width: 640px) {
    .hero-actions { flex-direction: column; }
    .hero-actions .btn { width: 100%; }
    .hero-social .btn { flex: 1 1 140px; }
    .trust-list { grid-template-columns: 1fr; padding-top: 4px; padding-bottom: 4px; }
    .trust-list li { padding: 16px 4px; }
    .trust-list li:nth-child(2) { border-top: 1px solid rgba(227, 194, 122, 0.18); }
    .cards { grid-template-columns: 1fr 1fr; gap: 14px; }
    .card:last-child { grid-column: 1 / -1; justify-self: center; width: calc(50% - 7px); }
    .card-label { font-size: 17px; margin-top: 10px; }
    .contact-grid { grid-template-columns: 1fr; }
    .contact-cta-row { flex-direction: column; }
    .contact-cta-row .btn { text-align: center; }
    .about-body { font-size: 16.5px; }
  }
</style>
