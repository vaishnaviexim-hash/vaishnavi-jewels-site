---
import InfoPage from '../layouts/InfoPage.astro';
const faqs: [string, string][] = [
  ['What is Polki jewellery?', 'Polki jewellery uses diamonds in their uncut form, set in gold. The stones keep a flatter, natural shape and give a soft, warm glow instead of sharp sparkle.'],
  ['What is the difference between Polki and Jadau?', 'Polki is the stone (an uncut diamond); Jadau is the hand-setting technique used to fix stones into gold. Many Polki pieces are made in the Jadau technique.'],
  ['Can Polki jewellery be customised?', 'Yes. We make Polki in-house, so the size, layout and the colours of accompanying emeralds, rubies and pearls can be adjusted to your outfit.'],
  ['How should I care for Polki jewellery?', 'Store each piece separately in a soft pouch or lined box, keep it away from water, perfume and hairspray, and wipe it gently with a soft dry cloth after wearing.'],
  ['Is Polki only for brides?', 'No. Lighter Polki earrings, pendants and bangles are popular for festivals, family functions and gifting, as well as for weddings.'],
  ['Do you make Polki choker sets for a wedding?', 'Yes. Polki choker sets are among the pieces brides choose most for the wedding ceremony, and we make them in our own manufacturing unit, often with emeralds, rubies or pearls and matching earrings and a maang tikka. The size, stones and weight can be adjusted to your lehenga and made to suit your budget; WhatsApp us for photos or a video call.'],
];
