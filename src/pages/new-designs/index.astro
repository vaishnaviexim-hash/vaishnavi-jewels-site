---
import InfoPage from '../../layouts/InfoPage.astro';
import { business as b } from '../../data/business.js';
import { plain, plainSet } from '../../data/images.js';
import { designs, groups as getGroups, catLink } from '../../data/new-designs.js';
const groups = getGroups();
const wa = (code: string, name: string) =>
  'https://wa.me/' + b.whatsappE164.replace('+', '') + '?text=' + encodeURIComponent(`Hi Vaishnavi Jewels, I saw design ${code} (${name}) on your website. Please share details.`);
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'New Designs by Vaishnavi Jewels',
  url: 'https://vaishnavijewels.com/new-designs',
  about: { '@id': 'https://vaishnavijewels.com/#store' },
  hasPart: designs.map((d) => ({ '@type': 'ImageObject', name: d.name, caption: d.text, contentUrl: plain(d.id, 1200) })),
};
---
<InfoPage
  title="New Jewellery Designs | Made to Order in Surat | Vaishnavi Jewels"
  description="Our newest diamond and gemstone jewellery designs, made to order in our own manufacturing unit in Surat. Enquire on WhatsApp for any design."
  path="/new-designs"
  eyebrow="NEW DESIGNS"
  heading="Our Newest Designs"
  intro="Fresh designs from Vaishnavi Jewels, each crafted to order in our own manufacturing unit in Surat. Choose a category to see the designs."
  extraSchema={[pageSchema]}
>
  <div class="nd-hub">
    {groups.map((g) => (
      <a class="nd-tile" href={catLink(g.cat)}>
        <img src={plain(g.items[0].id, 720)} srcset={plainSet(g.items[0].id, [480, 720, 960])} sizes="(max-width: 640px) 92vw, 360px" width="720" height="900" alt={g.items[0].alt} loading="lazy" decoding="async" />
        <span class="nd-tname">{g.cat}</span>
        <span class="nd-tcount">{g.items.length} new design{g.items.length === 1 ? '' : 's'}</span>
      </a>
    ))}
  </div>
  <h2>Made to order, to your choice</h2>
  <p>Every design is made in our own unit in Surat. You can choose the gold karat and colour, natural or <a href="/lab-grown-diamond-jewellery">lab-grown diamonds</a>, and the stone colours. Most custom pieces are ready in about 3 weeks. Visit us at {b.addressText} or see <a href="/delivery-across-india">delivery across India</a>.</p>
</InfoPage>
<style>
  .nd-hub { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 24px; margin: 8px 0 40px; }
  .nd-tile { display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: var(--color-ink, #2a1f1c); background: var(--color-ivory-deep, #f6efe4); border: 1px solid var(--color-line, #e6dccb); padding-bottom: 14px; }
  .nd-tile img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; display: block; margin-bottom: 10px; }
  .nd-tname { font-size: 20px; padding: 0 16px; }
  .nd-tcount { font-size: 13px; padding: 0 16px; color: var(--color-gold-deep, #8a6a2f); }
  .nd-cats { display: flex; flex-wrap: wrap; gap: 10px; margin: 4px 0 28px; }
  .nd-cats a { padding: 8px 16px; border: 1px solid var(--color-line, #e6dccb); text-decoration: none; color: var(--color-ink, #2a1f1c); font-size: 14px; }
  .nd-cats a:hover { border-color: var(--color-maroon, #5a1a2a); }
  .nd-cats span { color: var(--color-ink-soft, #5a4a44); }
  .nd-sec { scroll-margin-top: 90px; }
  .nd-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 24px; margin: 8px 0 40px; }
  .nd-card { margin: 0; background: var(--color-ivory-deep, #f6efe4); border: 1px solid var(--color-line, #e6dccb); }
  .nd-card img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .nd-card figcaption { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px 18px; }
  .nd-code { font-size: 12px; letter-spacing: 0.12em; color: var(--color-gold-deep, #8a6a2f); }
  .nd-text { color: var(--color-ink-soft, #5a4a44); font-size: 15px; }
  .nd-btn { margin-top: 6px; align-self: flex-start; padding: 9px 16px; border: 1px solid var(--color-maroon, #5a1a2a); color: var(--color-maroon, #5a1a2a); text-decoration: none; font-size: 14px; }
  .nd-btn:hover { background: var(--color-maroon, #5a1a2a); color: #fff; }
</style>
